// BigSeaa — B2B Marketplace data model
// Personas: Buyer / Supplier / Admin. Core: directory + RFQ/quotation + credits.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ----------------------------------------------------------------------------
// Enums
// ----------------------------------------------------------------------------
enum Role {
  BUYER
  SUPPLIER
  ADMIN
}

enum AccountMode {
  BUYER
  SUPPLIER
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum DocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum RfqStatus {
  OPEN
  CLOSED
  FLAGGED
  EXPIRED
}

enum QuotationStatus {
  PENDING
  ACCEPTED
  REJECTED
  WITHDRAWN
}

enum TransactionType {
  PURCHASE
  SPEND
  REFUND
  ADMIN_ADJUST
}

enum SavedItemType {
  SUPPLIER
  RFQ
  PRODUCT
}

enum NotificationChannel {
  EMAIL
  SMS
  WHATSAPP
  TELEGRAM
  IN_APP
}

// ----------------------------------------------------------------------------
// Identity & profiles
// ----------------------------------------------------------------------------
model User {
  id            String      @id @default(cuid())
  email         String      @unique
  emailVerified DateTime?
  passwordHash  String?
  googleId      String?     @unique
  name          String?
  image         String?
  phone         String?
  phoneVerified Boolean     @default(false)
  role          Role        @default(BUYER)
  activeMode    AccountMode @default(BUYER)
  status        UserStatus  @default(PENDING)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  buyerProfile    BuyerProfile?
  supplierProfile SupplierProfile?
  creditAccount   CreditAccount?
  notifSettings   NotificationSettings?
  rfqs            Rfq[]
  quotations      Quotation[]
  unlocks         SupplierUnlock[]
  savedItems      SavedItem[]
  transactions    Transaction[]
  notifications   Notification[]
  roleAssignments UserRole[]
  auditLogs       AuditLog[]            @relation("ActorLogs")
  accounts        Account[]
  sessions        Session[]

  @@index([role, status])
}

// ----------------------------------------------------------------------------
// Auth.js (NextAuth) adapter models + password reset
// ----------------------------------------------------------------------------
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  email     String
  token     String   @unique
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model BuyerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company   String?
  countryId String?
  country   Country? @relation(fields: [countryId], references: [id])
  about     String?
  updatedAt DateTime @updatedAt
}

model SupplierProfile {
  id                 String             @id @default(cuid())
  userId             String             @unique
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName        String
  slug               String             @unique
  about              String?
  strength           String?
  logoUrl            String?
  websiteUrl         String?
  contactEmail       String?
  contactPhone       String?
  countryId          String?
  country            Country?           @relation(fields: [countryId], references: [id])
  portId             String?
  port               Port?              @relation(fields: [portId], references: [id])
  paymentTerms       String?
  shippingTerms      String?
  verificationStatus VerificationStatus @default(UNVERIFIED)
  verifiedBadge      Boolean            @default(false)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  products   Product[]
  documents  CompanyDocument[]
  quotations Quotation[]
  unlocks    SupplierUnlock[]

  @@index([verificationStatus])
  @@index([countryId])
}

model CompanyDocument {
  id         String          @id @default(cuid())
  supplierId String
  supplier   SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  type       String
  fileUrl    String
  status     DocumentStatus  @default(PENDING)
  notes      String?
  createdAt  DateTime        @default(now())
}

// ----------------------------------------------------------------------------
// Catalog: categories & products
// ----------------------------------------------------------------------------
model Category {
  id       String     @id @default(cuid())
  name     String
  slug     String     @unique
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  imageUrl String?
  order    Int        @default(0)

  products Product[]
  rfqs     Rfq[]

  @@index([parentId])
}

model Product {
  id           String          @id @default(cuid())
  supplierId   String
  supplier     SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  categoryId   String?
  category     Category?       @relation(fields: [categoryId], references: [id])
  slug         String          @unique
  title        String
  description  String?
  moq          Int             @default(1)
  basePrice    Decimal         @db.Decimal(12, 2)
  baseCurrency String          @default("USD")
  images       String[]
  status       ProductStatus   @default(ACTIVE)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  prices ProductPrice[]

  @@index([categoryId, status])
  @@index([supplierId])
}

// Country-specific price overrides (fallback to FX conversion of basePrice)
model ProductPrice {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  country   String
  currency  String
  price     Decimal @db.Decimal(12, 2)

  @@unique([productId, country])
}

// ----------------------------------------------------------------------------
// RFQ / Quotation marketplace
// ----------------------------------------------------------------------------
model Rfq {
  id          String    @id @default(cuid())
  buyerId     String
  buyer       User      @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  title       String
  description String
  categoryId  String?
  category    Category? @relation(fields: [categoryId], references: [id])
  countryId   String?
  country     Country?  @relation(fields: [countryId], references: [id])
  budget      Decimal?  @db.Decimal(12, 2)
  currency    String    @default("USD")
  quantity    Int?
  moq         Int?
  status      RfqStatus @default(OPEN)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  quotations Quotation[]

  @@index([status, categoryId])
  @@index([buyerId])
}

model Quotation {
  id         String          @id @default(cuid())
  rfqId      String
  rfq        Rfq             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  price      Decimal         @db.Decimal(12, 2)
  currency   String          @default("USD")
  leadTime   String?
  message    String?
  status     QuotationStatus @default(PENDING)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@unique([rfqId, supplierId])
  @@index([supplierId])
}

// ----------------------------------------------------------------------------
// Credits / monetization
// ----------------------------------------------------------------------------
model CreditAccount {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        TransactionType
  amount      Int // credits delta (+/-)
  description String?
  stripeRef   String?
  createdAt   DateTime        @default(now())

  @@index([userId, createdAt])
}

model SupplierUnlock {
  id         String          @id @default(cuid())
  buyerId    String
  buyer      User            @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  creditCost Int             @default(1)
  unlockedAt DateTime        @default(now())

  @@unique([buyerId, supplierId])
}

model SavedItem {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      SavedItemType
  targetId  String
  createdAt DateTime      @default(now())

  @@unique([userId, type, targetId])
}

// ----------------------------------------------------------------------------
// Notifications
// ----------------------------------------------------------------------------
model NotificationSettings {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email    Boolean @default(true)
  sms      Boolean @default(false)
  whatsapp Boolean @default(false)
  telegram Boolean @default(false)
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel @default(IN_APP)
  type      String
  title     String
  body      String?
  payload   Json?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, readAt])
}

// ----------------------------------------------------------------------------
// CMS / content
// ----------------------------------------------------------------------------
model CmsPage {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  body      String
  published Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model Faq {
  id        String  @id @default(cuid())
  question  String
  answer    String
  category  String?
  order     Int     @default(0)
  published Boolean @default(true)
}

// ----------------------------------------------------------------------------
// Geo reference (admin/db managed)
// ----------------------------------------------------------------------------
model Country {
  id       String  @id @default(cuid())
  code     String  @unique // ISO-3166 alpha-2
  name     String
  currency String // ISO-4217
  dialCode String?

  ports            Port[]
  supplierProfiles SupplierProfile[]
  buyerProfiles    BuyerProfile[]
  rfqs             Rfq[]
}

model Port {
  id        String  @id @default(cuid())
  countryId String
  country   Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  name      String
  code      String?

  suppliers SupplierProfile[]

  @@index([countryId])
}

// ----------------------------------------------------------------------------
// Internal RBAC (admin) + audit
// ----------------------------------------------------------------------------
model RoleDef {
  id          String           @id @default(cuid())
  name        String           @unique
  description String?
  permissions RolePermission[]
  users       UserRole[]
}

model Permission {
  id    String           @id @default(cuid())
  key   String           @unique // e.g. "users.block"
  label String
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  role         RoleDef    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   RoleDef @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actor     User?    @relation("ActorLogs", fields: [actorId], references: [id])
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
}
